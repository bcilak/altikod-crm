# Local development only. Never reuse these credentials in production.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://saleshub:saleshub_local_only@localhost:5432/saleshub?schema=public&connect_timeout=3

# E-posta: geliştirmede `local` (bağlantılar .local-mail klasörüne yazılır, dışarı gönderilmez).
# Production `smtp` gerektirir; SMTP_SECURITY starttls (587) veya tls (465). `none` yalnız yerel testler içindir.
MAIL_TRANSPORT=local
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Altıkod CRM <crm@example.com>

# Mesajlarda paylaşılan dosyaların virüs taraması. Geliştirmede `none`: dosyalar "taranmadı" olarak işaretlenir (asla "temiz" değil).
# Production `clamd` gerektirir (deploy/compose.production.yml ClamAV servisini başlatır).
MALWARE_SCANNER=none
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310

# Production: migration/yedek sahip hesabı ile uygulama hesabı ayrıdır (docs/operations.md).
# MIGRATION_DATABASE_URL=postgresql://saleshub:<parola>@postgres:5432/saleshub
# APP_DB_USER=saleshub_app
# APP_DB_PASSWORD=
